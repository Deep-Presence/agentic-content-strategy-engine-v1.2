    },
    {
      "id": "1WhfShsbxpOkTH4CBqugx",
      "type": "text",
      "x": -67.15860421369456,
      "y": 5241.51012983453,
      "width": 909.1553853143732,
      "height": 352.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [
        "xQFeSHZ4_MUrTHjG0F0Rb"
      ],
      "frameId": "hfxJgSmAV0yuUmzh9ZEVz",
      "index": "b02",
      "roundness": null,
      "seed": 777701882,
      "version": 809,
      "versionNonce": 2034490042,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770374941845,
      "link": null,
      "locked": false,
      "text": "The output provides strategic\nrecommendations: proceed with\nsemantic optimization if proximity\ndrives citations, or pivot to authority-\nbuilding if embedding signals don't\nexplain citation success.",
      "fontSize": 47,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The output provides strategic recommendations: proceed with semantic optimization if proximity drives citations, or pivot to authority-building if embedding signals don't explain citation success.",
      "autoResize": false,
      "lineHeight": 1.25
    },
