      "link": null,
      "locked": false,
      "text": "Semantic and Structural Analysis",
      "fontSize": 50,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "UCD8u0_1rrWEQ2lPvv-3v",
      "originalText": "Semantic and Structural Analysis",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hxFO9TlmKKKbzmpCfHDFK",
      "type": "text",
      "x": -1148.3193941254547,
      "y": 4432.108659191433,
      "width": 802.8604800544301,
      "height": 1075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
      "frameId": "hfxJgSmAV0yuUmzh9ZEVz",
      "index": "aw",
      "roundness": null,
      "seed": 729483898,
      "version": 1537,
      "versionNonce": 310464058,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770374941845,
      "link": null,
      "locked": false,
      "text": "Tests whether semantic proximity in\nembedding space predicts citations by\ncomparing query embeddings against\ncited competitor content versus\nuncited content. \n\nCalculates the Semantic Proximity\nAdvantage (SPA) to validate if cited\ncontent is significantly closer to\nqueries in vector space, identifies\ncontent gaps where uncited content\ncould compete, analyzes citation\npatterns (domains, content types,\nstructure), \n\nCreates and interactive visualization\nof the embedding landscape, with\nrespected to query clusters, client's\nbrand content and competitor's\ncontent.",
      "fontSize": 43,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Tests whether semantic proximity in embedding space predicts citations by comparing query embeddings against cited competitor content versus uncited content. \n\nCalculates the Semantic Proximity Advantage (SPA) to validate if cited content is significantly closer to queries in vector space, identifies content gaps where uncited content could compete, analyzes citation patterns (domains, content types, structure), \n\nCreates and interactive visualization of the embedding landscape, with respected to query clusters, client's brand content and competitor's content.",
      "autoResize": false,
      "lineHeight": 1.25
    },
