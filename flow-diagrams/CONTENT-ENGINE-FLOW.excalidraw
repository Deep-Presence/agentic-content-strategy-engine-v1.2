    {
      "id": "OT5SR40aNfp2Q0nJ4Aai3",
      "type": "text",
      "x": 6870.380469258123,
      "y": 4097.983492690466,
      "width": 1342.8382854904858,
      "height": 1519.4184401617003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 80,
      "groupIds": [],
      "frameId": "hfxJgSmAV0yuUmzh9ZEVz",
      "index": "b3L",
      "roundness": null,
      "seed": 1893486822,
      "version": 671,
      "versionNonce": 984099386,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770374941846,
      "link": null,
      "locked": false,
      "text": "The sub-agentic system has a planner\nagent that does the following --\n\n-> Looks at the the structural gaps,\nand recommendation \n                \n-> figures out the right channel of\ncontent, content-outline, and prepares\nstrategy for that content. \n\n- Strategy includes: requirements /\nchecklists to make the content in that\nparticular outstanding\n                \n-> Assigns agents to work on the\ncontent (could be a collection of 5-10\nagents depending on content channel\ntype).",
      "fontSize": 67.52970845163115,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The sub-agentic system has a planner agent that does the following --\n\n-> Looks at the the structural gaps, and recommendation \n                \n-> figures out the right channel of content, content-outline, and prepares strategy for that content. \n\n- Strategy includes: requirements / checklists to make the content in that particular outstanding\n                \n-> Assigns agents to work on the content (could be a collection of 5-10 agents depending on content channel type).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VxK_irhsTudE2vu8Ob7D-",
      "type": "arrow",
      "x": 3393.7760316556596,
