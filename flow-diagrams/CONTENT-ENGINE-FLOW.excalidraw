    {
      "id": "SE88gxDdDmc6SaepPTuGe",
      "type": "text",
      "x": -169.92138326820185,
      "y": 4530.541314100284,
      "width": 1140.8043580327076,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [],
