{
  "info": {
    "name": "Content Strategy Engine API",
    "description": "Deep Presence — Content Strategy Engine API. Base URL: http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "slug", "value": "" },
    { "key": "product_slug", "value": "" },
    { "key": "run_id", "value": "" },
    { "key": "task_id", "value": "" },
    { "key": "audit_id", "value": "" },
    { "key": "brief_id", "value": "" },
    { "key": "prompt_id", "value": "" },
    { "key": "effective_slug", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/readiness",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aryank@example.com\",\n  \"password\": \"aryan@lovable\",\n  \"first_name\": \"Aryan\",\n  \"last_name\": \"Keshri\",\n  \"company_name\": \"lovable\",\n  \"company_domain\": \"lovable.dev\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.collectionVariables.set('slug', json.company_slug || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aryank@example.com\",\n  \"password\": \"aryan@lovable\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Create Invite",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/invite",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"role\": \"member\"\n}"
            }
          }
        },
        {
          "name": "Join (Accept Invite)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/join",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_code\": \"INVITE_CODE_HERE\",\n  \"password\": \"securepassword123\",\n  \"first_name\": \"New\",\n  \"last_name\": \"User\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Get Company Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/companies/{{slug}}"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/companies/{{slug}}/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Product X\",\n  \"slug\": \"product-x\",\n  \"domain\": \"productx.example.com\",\n  \"description\": \"Our flagship product\"\n}"
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/companies/{{slug}}/products/{{product_slug}}"
