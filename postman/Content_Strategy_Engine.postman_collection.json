            "body": {
              "mode": "raw",
              "raw": "{\n  \"industry\": \"SaaS\",\n  \"seed_personas\": [],\n  \"seed_urls\": [],\n  \"max_pages\": 200,\n  \"max_depth\": 4,\n  \"max_personas\": 5,\n  \"max_authors\": 3,\n  \"max_queries\": 75,\n  \"platforms\": [\"perplexity\", \"openai\", \"gemini\", \"claude\"],\n  \"language\": \"en\",\n  \"force_rerun\": false\n}"
            }
