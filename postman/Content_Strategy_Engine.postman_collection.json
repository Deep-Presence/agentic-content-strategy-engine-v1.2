    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Start Onboarding",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.run_id) {",
                  "    pm.collectionVariables.set('run_id', json.run_id);",
                  "    pm.collectionVariables.set('task_id', json.run_id);",
                  "}"
                ]
