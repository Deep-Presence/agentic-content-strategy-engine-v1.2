        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/v1/companies/{{company_slug}}/products/{{product_slug}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product Name\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/companies/{{company_slug}}/products/{{product_slug}}"
          }
        }
      ]
    },
    {
      "name": "Knowledge Base",
      "item": [
        {
          "name": "Start KB Pipeline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.run_id) {",
                  "    pm.collectionVariables.set('run_id', json.run_id);",
                  "    pm.collectionVariables.set('task_id', json.run_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/knowledge-base/start",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Ramp\",\n  \"domain\": \"ramp.com\",\n  \"product_slug\": null,\n  \"force_rerun\": false,\n  \"mode\": \"full\",\n  \"auto_approve_checkpoints\": []\n}"
            }
          }
        },
        {
          "name": "Get KB Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/knowledge-base/{{run_id}}/status"
          }
        },
        {
          "name": "KB HITL Approve",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/knowledge-base/{{run_id}}/approve",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"accept\",\n  \"revision_note\": null\n}"
            }
          }
        },
        {
          "name": "KB Health Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/knowledge-base/{{company_slug}}/health?threshold_override=90",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "knowledge-base", "{{company_slug}}", "health"],
              "query": [
                { "key": "threshold_override", "value": "90", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Refresh Stale KB Docs",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/knowledge-base/{{company_slug}}/refresh-stale",
