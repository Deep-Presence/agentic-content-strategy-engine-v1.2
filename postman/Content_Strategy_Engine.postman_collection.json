          "name": "Get Gap Queries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/companies/{{slug}}/gap-analysis/queries?page=1&page_size=15&sort_by=gap_score&sort_dir=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "companies", "{{slug}}", "gap-analysis", "queries"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "15" },
                { "key": "sort_by", "value": "gap_score" },
                { "key": "sort_dir", "value": "desc" },
                { "key": "cluster", "value": "", "disabled": true },
