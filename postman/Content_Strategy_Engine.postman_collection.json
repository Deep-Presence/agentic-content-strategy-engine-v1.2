      "item": [
        {
          "name": "Get Gap Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/companies/{{slug}}/gap-analysis/summary",
              "host": ["{{base_url}}"],
