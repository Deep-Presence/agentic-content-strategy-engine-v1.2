# ============================================================
# Deep Presence Content Strategy Engine — Environment Variables
# ============================================================
# Copy to .env.local and fill in values. Never commit .env.local.

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://deep_presence:password@localhost:5432/deep_presence
DATABASE_ECHO=false

# --- LLM API Keys (REQUIRED for pipelines) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...

# --- Google / Gemini ---
GOOGLE_API_KEY_GAP_ANALYSIS=
GOOGLE_API_KEY_AUDIENCE_PERSONA=
GOOGLE_API_KEY_REDDIT_HIL=
GOOGLE_API_KEY_COMPANY_DEEPAGENT=
GOOGLE_API_KEY_PERSONA_RESEARCH_DEEPAGENT=

# --- Observability (LangSmith) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=content-engine

# --- Reddit (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DeepPresence/1.0

# --- Webhooks ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Brave Search ---
BRAVE_SEARCH_API_KEY=

# --- Redis ---
# Required for distributed EventBus, pipeline locks, semaphore, cache, HITL checkpoints.
# App starts without Redis — all features degrade gracefully to in-memory/file fallbacks.
REDIS_URL=redis://:your_password@localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=20.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Feature toggles (all require REDIS_URL to take effect)
REDIS_EVENT_BUS=false            # Redis Streams-backed SSE event bus (multi-worker)
REDIS_PIPELINE_STATE=false       # Redis Hashes for pipeline state + distributed slug locks
REDIS_CHECKPOINTER=true          # RedisSaver for LangGraph HITL checkpoints

# --- API ---
API_CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
