# ============================================================
# Deep Presence Content Strategy Engine — Environment Variables
# ============================================================
# Copy to .env.local and fill in values. Never commit .env.local.

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://deep_presence:password@localhost:5432/deep_presence
DATABASE_ECHO=false

# --- LLM API Keys (REQUIRED for pipelines) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...

# --- Google / Gemini ---
GOOGLE_API_KEY_GAP_ANALYSIS=
GOOGLE_API_KEY_AUDIENCE_PERSONA=
GOOGLE_API_KEY_REDDIT_HIL=
GOOGLE_API_KEY_COMPANY_DEEPAGENT=
GOOGLE_API_KEY_PERSONA_RESEARCH_DEEPAGENT=

# --- Observability (LangSmith) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=content-engine

# --- Reddit (PRAW) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DeepPresence/1.0

# --- Webhooks ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Brave Search ---
BRAVE_SEARCH_API_KEY=

# --- Storage Backend ---
STORAGE_BACKEND=r2  # "r2" (default) or "local"

# --- Cloudflare R2 (required — R2 is the default storage backend) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=deep-presence-prod
# R2_ENDPOINT_URL=  # Optional: auto-derived from R2_ACCOUNT_ID

# --- API ---
API_CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
